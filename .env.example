# Copy to .env locally; configure real values in Render's environment settings.
BUSINESS_PHONE=+15555550100
DATABASE_PATH=missed_calls.db
ENABLE_DEV_ROUTES=false

# Keep false until real SMS sending has been explicitly approved.
ENABLE_SMS_FOLLOWUP=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# SMS-capable Twilio sender; separate from the protected BUSINESS_PHONE destination.
TWILIO_SMS_FROM=
